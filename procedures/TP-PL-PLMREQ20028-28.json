{
  "id": "PLM-PR-200-28",
  "setup": [
    {
      "at": [
        [
          0,
          0
        ]
      ],
      "write": "Vehicle_Speed"
    },
    {
      "at": [
        [
          0,
          "PRIMARY"
        ]
      ],
      "write": "Latch_State"
    },
    {
      "at": [
        [
          0,
          false
        ]
      ],
      "write": "Liftgate_Switch_In"
    },
    {
      "at": [
        [
          0,
          false
        ]
      ],
      "write": "Liftgate_Switch_Ext"
    },
    {
      "at": [
        [
          0,
          false
        ]
      ],
      "write": "Kick_Detected"
    },
    {
      "at": [
        [
          0,
          false
        ]
      ],
      "write": "Pinch_Strip"
    }
  ],
  "steps": [
    {
      "id": "1",
      "checks": [
        {
          "op": "eq",
          "signal": "Liftgate_Position",
          "window": [
            0,
            1
          ],
          "expected": 0
        },
        {
          "op": "eq",
          "signal": "Liftgate_Motion",
          "window": [
            0,
            1
          ],
          "expected": "STOP"
        }
      ],
      "description": "Verify initial conditions: liftgate fully closed at 0% position and vehicle at rest"
    },
    {
      "id": "2",
      "checks": [
        {
          "op": "eq",
          "signal": "Latch_Cmd",
          "window": [
            0,
            0.5
          ],
          "expected": "RELEASE",
          "tolerance": "T100ms"
        }
      ],
      "writes": [
        {
          "at": [
            [
              0,
              true
            ]
          ],
          "signal": "Liftgate_Switch_Ext"
        }
      ],
      "description": "Activate exterior handle and verify module commands latch to release"
    },
    {
      "id": "3",
      "checks": [
        {
          "op": "eq",
          "signal": "Spindle_Dir",
          "window": [
            0,
            1
          ],
          "expected": "OPEN"
        },
        {
          "op": "eq",
          "signal": "Liftgate_Motion",
          "window": [
            0,
            1
          ],
          "expected": "OPENING"
        }
      ],
      "description": "Verify module commands spindle motors to open the liftgate"
    },
    {
      "id": "4",
      "checks": [
        {
          "op": "gt",
          "signal": "Liftgate_Position",
          "window": [
            0,
            2
          ],
          "expected": 5
        }
      ],
      "description": "Verify liftgate position increases confirming opening motion"
    }
  ],
  "product": "plms",
  "teardown": [
    {
      "at": [
        [
          0,
          false
        ]
      ],
      "write": "Liftgate_Switch_Ext"
    }
  ],
  "schema_version": "1.0",
  "test_requirement_id": "PLM-TR-200-28"
}