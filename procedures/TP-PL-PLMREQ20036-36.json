{
  "id": "PLM-PR-200-36",
  "setup": [
    {
      "at": [
        [
          0,
          0
        ]
      ],
      "write": "Vehicle_Speed"
    },
    {
      "at": [
        [
          0,
          false
        ]
      ],
      "write": "Pinch_Strip"
    },
    {
      "at": [
        [
          0,
          "RELEASED"
        ]
      ],
      "write": "Latch_State"
    },
    {
      "at": [
        [
          0,
          false
        ]
      ],
      "write": "Kick_Detected"
    },
    {
      "at": [
        [
          0,
          false
        ]
      ],
      "write": "Liftgate_Switch_Ext"
    }
  ],
  "steps": [
    {
      "id": "1",
      "checks": [
        {
          "op": "eq",
          "signal": "Liftgate_Motion",
          "window": [
            0.5,
            2
          ],
          "expected": "OPENING"
        },
        {
          "op": "gt",
          "signal": "Liftgate_Position",
          "window": [
            0.5,
            3
          ],
          "expected": 5
        }
      ],
      "writes": [
        {
          "at": [
            [
              0,
              true
            ],
            [
              0.5,
              false
            ]
          ],
          "signal": "Liftgate_Switch_In"
        }
      ],
      "description": "Initiate liftgate opening from closed position using interior switch"
    },
    {
      "id": "2",
      "checks": [
        {
          "op": "eq",
          "signal": "Liftgate_Position",
          "window": [
            0,
            15
          ],
          "expected": 100
        }
      ],
      "description": "Allow liftgate to reach fully open position (100%)"
    },
    {
      "id": "3",
      "checks": [
        {
          "op": "eq",
          "signal": "Liftgate_Motion",
          "window": [
            0,
            0.5
          ],
          "expected": "STOP",
          "tolerance": "T100ms"
        },
        {
          "op": "always_eq",
          "signal": "Liftgate_Position",
          "window": [
            0.5,
            2
          ],
          "expected": 100
        }
      ],
      "description": "Verify spindle motors stop when fully open position is detected"
    }
  ],
  "product": "plms",
  "teardown": [
    {
      "at": [
        [
          0,
          false
        ]
      ],
      "write": "Liftgate_Switch_In"
    }
  ],
  "schema_version": "1.0",
  "test_requirement_id": "PLM-TR-200-36"
}