      "writes": [
        {
          "at": [
            [
              0,
              true
            ],
            [
              0.5,
              false
            ]
          ],
          "signal": "Liftgate_Switch_In"
        }
      ],
      "description": "Send interior switch request while speed at 5 km/h and verify request is rejected"
    },
    {
      "id": "3",
      "checks": [
        {
          "op": "always_eq",
          "signal": "Liftgate_Motion",
          "window": [
            0,
            1
          ],
          "expected": "STOP"
        }
      ],
      "writes": [
        {
          "at": [
            [
              0,
              true
            ],
            [
              0.5,
              false
            ]
          ],
          "signal": "Liftgate_Switch_Ext"
        }
      ],
      "description": "Send exterior switch request while speed at 5 km/h and verify request is rejected"
    },
    {
      "id": "4",
      "checks": [
        {
          "op": "always_eq",
          "signal": "Liftgate_Motion",
          "window": [
            0,
            1
          ],
          "expected": "STOP"
        }
      ],
      "writes": [
        {
          "at": [
            [
              0,
              true
            ],
            [
              0.5,
              false
            ]
          ],
          "signal": "Kick_Detected"
        }
      ],
      "description": "Send kick sensor request while speed at 5 km/h and verify request is rejected"
    },
    {
      "id": "6",
      "checks": [
        {
          "op": "always_eq",
          "signal": "Liftgate_Motion",
          "window": [
            0.5,
            1.5
          ],
          "expected": "STOP"
        }
      ],
      "writes": [
        {
          "at": [
            [
              0,
              10
            ]
          ],
