          "at": [
            [
              0.5,
              true
            ],
            [
              1,
              false
            ]
          ],
          "signal": "Liftgate_Switch_In"
        }
      ],
      "description": "Set speed below 5 km/h and verify interior switch request is now accepted"
    }
