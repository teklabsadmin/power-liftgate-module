{
  "id": "PLM-TP-200-27",
  "setup": [
    {
      "at": [
        [
          0,
          4
        ]
      ],
      "write": "Vehicle_Speed"
    },
    {
      "at": [
        [
          0,
          false
        ]
      ],
      "write": "Liftgate_Switch_In"
    },
    {
      "at": [
        [
          0,
          false
        ]
      ],
      "write": "Liftgate_Switch_Ext"
    },
    {
      "at": [
        [
          0,
          false
        ]
      ],
      "write": "Kick_Detected"
    },
    {
      "at": [
        [
          0,
          false
        ]
      ],
      "write": "Pinch_Strip"
    },
    {
      "at": [
        [
          0,
          "RELEASED"
        ]
      ],
      "write": "Latch_State"
    }
  ],
  "steps": [
    {
      "id": "1",
      "checks": [
        {
          "op": "in_range",
          "signal": "Liftgate_Position",
          "window": [
            0,
            1
          ],
          "expected": [
            95,
            100
          ]
        }
      ],
      "description": "Verify precondition: vehicle speed is below 5 km/h and liftgate is fully open"
    },
    {
      "id": "2",
      "checks": [
        {
          "op": "eq",
          "signal": "Liftgate_Motion",
          "window": [
            0,
            0.5
          ],
          "expected": "STOP"
        }
      ],
      "writes": [
        {
          "at": [
            [
              0,
              true
            ]
          ],
          "signal": "Liftgate_Switch_In"
        }
      ],
      "description": "Activate the interior switch to request liftgate closure"
    },
    {
      "id": "3",
      "checks": [
        {
          "op": "eq",
          "signal": "Spindle_Dir",
          "window": [
            0,
            1
          ],
          "expected": "CLOSE",
          "tolerance": "T100ms"
        }
      ],
      "description": "Verify module commands spindle motors to close direction"
    },
    {
      "id": "4",
      "checks": [
        {
          "op": "eq",
          "signal": "Liftgate_Motion",
          "window": [
            0,
            1
          ],
          "expected": "CLOSING",
          "tolerance": "T100ms"
        }
      ],
      "description": "Verify liftgate motion transitions to closing"
    },
    {
      "id": "5",
      "checks": [
        {
          "op": "lt",
          "signal": "Liftgate_Position",
          "window": [
            0,
            5
          ],
          "expected": 50
        }
      ],
      "description": "Monitor liftgate position decreasing as it closes"
    },
    {
      "id": "6",
      "checks": [
        {
          "op": "lt",
          "signal": "Liftgate_Position",
          "window": [
            0,
            2
          ],
          "expected": 10
        }
      ],
      "writes": [
        {
          "at": [
            [
              0,
              "SECONDARY"
            ]
          ],
          "signal": "Latch_State"
        }
      ],
      "description": "Simulate liftgate reaching closed position"
    },
    {
      "id": "7",
      "checks": [
        {
          "op": "eq",
          "signal": "Latch_Cmd",
          "window": [
            0,
            1
          ],
          "expected": "CINCH",
          "tolerance": "T100ms"
        }
      ],
      "description": "Verify latch cinches to primary lock position"
    },
    {
      "id": "8",
      "checks": [
        {
          "op": "eq",
          "signal": "Liftgate_Motion",
          "window": [
            0,
            1
          ],
          "expected": "STOP",
          "tolerance": "T100ms"
        }
      ],
      "writes": [
        {
          "at": [
            [
              0,
              "PRIMARY"
            ]
          ],
          "signal": "Latch_State"
        }
      ],
      "description": "Simulate latch achieving primary lock"
    },
    {
      "id": "9",
      "checks": [
        {
          "op": "in_range",
          "signal": "Liftgate_Position",
          "window": [
            0,
            1
          ],
          "expected": [
            0,
            5
          ]
        },
        {
          "op": "eq",
          "signal": "Liftgate_Fault",
          "window": [
            0,
            1
          ],
          "expected": "0x00"
        }
      ],
      "description": "Verify liftgate is fully closed and locked"
    }
  ],
  "product": "plms",
  "teardown": [
    {
      "at": [
        [
          0,
          false
        ]
      ],
      "write": "Liftgate_Switch_In"
    }
  ],
  "schema_version": "1.0",
  "test_requirement_id": "PLM-TR-200-27"
}