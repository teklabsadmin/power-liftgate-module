          "signal": "Liftgate_Position",
          "window": [
            0,
            2
          ],
          "expected": 0
        },
        {
          "op": "eq",
          "signal": "Liftgate_Motion",
          "window": [
            0,
            2
          ],
          "expected": "STOP"
        }
      ],
      "writes": [
        {
          "at": [
            [
              0,
              "PRIMARY"
            ]
          ],
          "signal": "Latch_State"
        },
        {
          "at": [
            [
              0,
              0
            ]
          ],
          "signal": "Vehicle_Speed"
        },
        {
          "at": [
            [
              0,
              false
            ]
          ],
          "signal": "Kick_Detected"
        },
        {
          "at": [
            [
              0,
              false
            ]
          ],
          "signal": "Liftgate_Switch_Ext"
        }
      ],
      "description": "Set vehicle to locked state with liftgate closed and module in sleep mode"
    },
    {
      "id": "2",
      "checks": [
        {
          "op": "eq",
          "signal": "Latch_Cmd",
          "window": [
            0,
            1
          ],
          "expected": "RELEASE",
          "tolerance": "T100ms"
        }
      ],
      "writes": [
        {
          "at": [
            [
              0,
              true
            ],
            [
              0.2,
              false
            ]
          ],
          "signal": "Liftgate_Switch_Ext"
        }
      ],
      "description": "Trigger wake-up event using exterior handle request"
    },
    {
      "id": "3",
      "checks": [
        {
          "op": "always_eq",
          "signal": "Liftgate_Motion",
          "window": [
            0,
            32
          ],
          "expected": "STOP"
        },
        {
          "op": "eq",
          "signal": "Liftgate_Fault",
          "window": [
            30,
            32
          ],
          "expected": "0x00"
        }
      ],
      "description": "Wait 30 seconds with no activity to verify module returns to sleep mode"
    }
  ],
  "product": "plms",
  "schema_version": "1.0",
