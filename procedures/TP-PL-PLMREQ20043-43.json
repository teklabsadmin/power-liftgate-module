{
  "id": "PLM-PROC-200-43",
  "steps": [
    {
      "id": "1",
      "checks": [
        {
          "op": "in_range",
          "signal": "Liftgate_Position",
          "window": [
            0.5,
            1.5
          ],
          "expected": [
            0,
            100
          ]
        }
      ],
      "writes": [
        {
          "at": [
            [
              0,
              "PRIMARY"
            ]
          ],
          "signal": "Latch_State"
        },
        {
          "at": [
            [
              0,
              0
            ]
          ],
          "signal": "Vehicle_Speed"
        }
      ],
      "description": "Verify module transmits liftgate position on body CAN when queried"
    },
    {
      "id": "2",
      "checks": [
        {
          "op": "eq",
          "signal": "Liftgate_Motion",
          "window": [
            0,
            1
          ],
          "expected": "STOP"
        }
      ],
      "description": "Verify module transmits motion state on body CAN"
    },
    {
      "id": "3",
      "checks": [
        {
          "op": "eq",
          "signal": "Latch_Cmd",
          "window": [
            0,
            0.5
          ],
          "expected": "RELEASE",
          "tolerance": "T100ms"
        },
        {
          "op": "eq",
          "signal": "Liftgate_Motion",
          "window": [
            0.2,
            1
          ],
          "expected": "OPENING"
        }
      ],
      "writes": [
        {
          "at": [
            [
              0,
              true
            ]
          ],
          "signal": "Liftgate_Switch_In"
        }
      ],
      "description": "Verify module receives interior switch request from body CAN and responds"
    },
    {
      "id": "4",
      "checks": [
        {
          "op": "eq",
          "signal": "Latch_Cmd",
          "window": [
            1,
            1.5
          ],
          "expected": "RELEASE",
          "tolerance": "T100ms"
        }
      ],
      "writes": [
        {
          "at": [
            [
              0,
              false
            ]
          ],
          "signal": "Liftgate_Switch_In"
        },
        {
          "at": [
            [
              0.5,
              "PRIMARY"
            ]
          ],
          "signal": "Latch_State"
        },
        {
          "at": [
            [
              1,
              true
            ]
          ],
          "signal": "Liftgate_Switch_Ext"
        }
      ],
      "description": "Verify module receives exterior handle request from body CAN and responds"
    },
    {
      "id": "5",
      "checks": [
        {
          "op": "eq",
          "signal": "Latch_Cmd",
          "window": [
            1,
            1.5
          ],
          "expected": "RELEASE",
          "tolerance": "T100ms"
        },
        {
          "op": "eq",
          "signal": "Liftgate_Motion",
          "window": [
            1.2,
            2
          ],
          "expected": "OPENING"
        }
      ],
      "writes": [
        {
          "at": [
            [
              0,
              false
            ]
          ],
          "signal": "Liftgate_Switch_Ext"
        },
        {
          "at": [
            [
              0.5,
              "PRIMARY"
            ]
          ],
          "signal": "Latch_State"
        },
        {
          "at": [
            [
              1,
              true
            ]
          ],
          "signal": "Kick_Detected"
        }
      ],
      "description": "Verify module receives kick sensor input from body CAN and initiates opening"
    },
    {
      "id": "6",
      "checks": [
        {
          "op": "eq",
          "signal": "Liftgate_Motion",
          "window": [
            1,
            2
          ],
          "expected": "STOP"
        }
      ],
      "writes": [
        {
          "at": [
            [
              0,
              false
            ]
          ],
          "signal": "Kick_Detected"
        },
        {
          "at": [
            [
              0.5,
              15
            ]
          ],
          "signal": "Vehicle_Speed"
        },
        {
          "at": [
            [
              1,
              true
            ]
          ],
          "signal": "Liftgate_Switch_In"
        }
      ],
      "description": "Verify module receives vehicle speed from body CAN and inhibits operation when moving"
    },
    {
      "id": "7",
      "checks": [
        {
          "op": "eq",
          "signal": "Spindle_Dir",
          "window": [
            0.6,
            1.5
          ],
          "expected": "OPEN"
        }
      ],
      "writes": [
        {
          "at": [
            [
              0,
              false
            ]
          ],
          "signal": "Liftgate_Switch_In"
        },
        {
          "at": [
            [
              0.2,
              0
            ]
          ],
          "signal": "Vehicle_Speed"
        },
        {
          "at": [
            [
              0.5,
              "RELEASED"
            ]
          ],
          "signal": "Latch_State"
        }
      ],
      "description": "Verify module transmits spindle direction command on body CAN"
    },
    {
      "id": "8",
      "checks": [
        {
          "op": "gt",
          "signal": "Liftgate_Fault",
          "window": [
            0,
            1
          ],
          "expected": "0x00"
        },
        {
          "op": "eq",
          "signal": "Liftgate_Motion",
          "window": [
            0.1,
            1
          ],
          "expected": "STOP"
        }
      ],
      "writes": [
        {
          "at": [
            [
              0,
              true
            ]
          ],
          "signal": "Pinch_Strip"
        }
      ],
      "description": "Verify module transmits fault codes on body CAN when detected"
    }
  ],
  "product": "plms",
  "schema_version": "1.0",
  "test_requirement_id": "PLM-TR-200-43"
}