{
  "id": "PLM-PR-200-49",
  "setup": [
    {
      "at": [
        [
          0,
          0
        ]
      ],
      "write": "Vehicle_Speed"
    },
    {
      "at": [
        [
          0,
          "PRIMARY"
        ]
      ],
      "write": "Latch_State"
    },
    {
      "at": [
        [
          0,
          false
        ]
      ],
      "write": "Liftgate_Switch_In"
    },
    {
      "at": [
        [
          0,
          false
        ]
      ],
      "write": "Liftgate_Switch_Ext"
    },
    {
      "at": [
        [
          0,
          false
        ]
      ],
      "write": "Kick_Detected"
    },
    {
      "at": [
        [
          0,
          false
        ]
      ],
      "write": "Pinch_Strip"
    }
  ],
  "steps": [
    {
      "id": "1",
      "checks": [
        {
          "op": "eq",
          "signal": "Liftgate_Motion",
          "window": [
            0,
            1
          ],
          "expected": "STOP"
        }
      ],
      "writes": [
        {
          "at": [
            [
              0,
              2.5
            ]
          ],
          "signal": "Vehicle_Speed"
        }
      ],
      "description": "Set vehicle speed to 2.5 km/h (mid-range between 0.1 and 4.9 km/h)"
    },
    {
      "id": "2",
      "checks": [
        {
          "op": "eq",
          "signal": "Latch_Cmd",
          "window": [
            0,
            0.5
          ],
          "expected": "RELEASE",
          "tolerance": "T100ms"
        },
        {
          "op": "eq",
          "signal": "Spindle_Dir",
          "window": [
            0,
            0.5
          ],
          "expected": "OPEN"
        },
        {
          "op": "eq",
          "signal": "Liftgate_Motion",
          "window": [
            0,
            0.5
          ],
          "expected": "OPENING"
        }
      ],
      "writes": [
        {
          "at": [
            [
              0,
              true
            ]
          ],
          "signal": "Liftgate_Switch_In"
        }
      ],
      "description": "Send open request via interior switch while at low speed"
    },
    {
      "id": "3",
      "checks": [
        {
          "op": "eq",
          "signal": "Liftgate_Motion",
          "window": [
            0.5,
            2
          ],
          "expected": "OPENING"
        },
        {
          "op": "gt",
          "signal": "Liftgate_Position",
          "window": [
            1,
            2
          ],
          "expected": 10
        }
      ],
      "writes": [
        {
          "at": [
            [
              0,
              false
            ]
          ],
          "signal": "Liftgate_Switch_In"
        },
        {
          "at": [
            [
              0.2,
              "RELEASED"
            ]
          ],
          "signal": "Latch_State"
        }
      ],
      "description": "Release interior switch and allow liftgate to open"
    },
    {
      "id": "4",
      "checks": [
        {
          "op": "eq",
          "signal": "Liftgate_Motion",
          "window": [
            0.2,
            1
          ],
          "expected": "STOP"
        }
      ],
      "writes": [
        {
          "at": [
            [
              0,
              true
            ],
            [
              0.1,
              false
            ]
          ],
          "signal": "Liftgate_Switch_In"
        }
      ],
      "description": "Stop liftgate motion and verify stable state"
    },
    {
      "id": "5",
      "checks": [
        {
          "op": "eq",
          "signal": "Spindle_Dir",
          "window": [
            0,
            0.5
          ],
          "expected": "CLOSE"
        },
        {
          "op": "eq",
          "signal": "Liftgate_Motion",
          "window": [
            0,
            0.5
          ],
          "expected": "CLOSING"
        }
      ],
      "writes": [
        {
          "at": [
            [
              0,
              true
            ]
          ],
          "signal": "Liftgate_Switch_Ext"
        }
      ],
      "description": "Send close request via exterior handle at low speed"
    },
    {
      "id": "6",
      "checks": [
        {
          "op": "eq",
          "signal": "Liftgate_Motion",
          "window": [
            0.5,
            2
          ],
          "expected": "CLOSING"
        }
      ],
      "writes": [
        {
          "at": [
            [
              0,
              false
            ]
          ],
          "signal": "Liftgate_Switch_Ext"
        }
      ],
      "description": "Release exterior switch and verify closing continues"
    },
    {
      "id": "7",
      "checks": [
        {
          "op": "eq",
          "signal": "Liftgate_Motion",
          "window": [
            0.5,
            1.5
          ],
          "expected": "STOP"
        }
      ],
      "writes": [
        {
          "at": [
            [
              0,
              0.1
            ]
          ],
          "signal": "Vehicle_Speed"
        },
        {
          "at": [
            [
              0.2,
              true
            ],
            [
              0.3,
              false
            ]
          ],
          "signal": "Liftgate_Switch_In"
        }
      ],
      "description": "Set vehicle speed to lower bound (0.1 km/h) and send kick sensor request"
    },
    {
      "id": "8",
      "checks": [
        {
          "op": "eq",
          "signal": "Latch_Cmd",
          "window": [
            0,
            0.5
          ],
          "expected": "RELEASE",
          "tolerance": "T100ms"
        },
        {
          "op": "eq",
          "signal": "Spindle_Dir",
          "window": [
            0,
            0.5
          ],
          "expected": "OPEN"
        },
        {
          "op": "eq",
          "signal": "Liftgate_Motion",
          "window": [
            0,
            0.5
          ],
          "expected": "OPENING"
        }
      ],
      "writes": [
        {
          "at": [
            [
              0,
              true
            ],
            [
              0.1,
              false
            ]
          ],
          "signal": "Kick_Detected"
        }
      ],
      "description": "Send kick detected signal and verify open request is accepted"
    },
    {
      "id": "9",
      "checks": [
        {
          "op": "eq",
          "signal": "Liftgate_Motion",
          "window": [
            0.5,
            2
          ],
          "expected": "OPENING"
        }
      ],
      "writes": [
        {
          "at": [
            [
              0,
              4.9
            ]
          ],
          "signal": "Vehicle_Speed"
        }
      ],
      "description": "Set vehicle speed to upper bound (4.9 km/h) and verify motion continues"
    }
  ],
  "product": "plms",
  "teardown": [
    {
      "at": [
        [
          0,
          0
        ]
      ],
      "write": "Vehicle_Speed"
    },
    {
      "at": [
        [
          0,
          false
        ]
      ],
      "write": "Liftgate_Switch_In"
    },
    {
      "at": [
        [
          0,
          false
        ]
      ],
      "write": "Liftgate_Switch_Ext"
    },
    {
      "at": [
        [
          0,
          false
        ]
      ],
      "write": "Kick_Detected"
    }
  ],
  "schema_version": "1.0",
