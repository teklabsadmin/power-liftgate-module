{
  "id": "PLM-TP-200-39",
  "steps": [
    {
      "id": "1",
      "checks": [
        {
          "op": "eq",
          "signal": "Liftgate_Motion",
          "window": [
            0,
            1
          ],
          "expected": "OPENING"
        }
      ],
      "writes": [
        {
          "at": [
            [
              0,
              true
            ]
          ],
          "signal": "Liftgate_Switch_In"
        }
      ],
      "description": "Verify module is responsive to interior switch input while vehicle is awake"
    },
    {
      "id": "2",
      "checks": [
        {
          "op": "gt",
          "signal": "Liftgate_Position",
          "window": [
            2,
            4
          ],
          "expected": 20
        }
      ],
      "writes": [
        {
          "at": [
            [
              0,
              false
            ]
          ],
          "signal": "Liftgate_Switch_In"
        }
      ],
      "description": "Reset interior switch and allow gate to reach partial open position"
    },
    {
      "id": "3",
      "checks": [
        {
          "op": "eq",
