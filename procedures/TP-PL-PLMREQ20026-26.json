{
  "id": "PLM-TP-200-26",
  "setup": [
    {
      "at": [
        [
          0,
          0
        ]
      ],
      "write": "Vehicle_Speed"
    },
    {
      "at": [
        [
          0,
          "PRIMARY"
        ]
      ],
      "write": "Latch_State"
    },
    {
      "at": [
        [
          0,
          false
        ]
      ],
      "write": "Liftgate_Switch_In"
    },
    {
      "at": [
        [
          0,
          false
        ]
      ],
      "write": "Liftgate_Switch_Ext"
    },
    {
      "at": [
        [
          0,
          false
        ]
      ],
      "write": "Kick_Detected"
    },
    {
      "at": [
        [
          0,
          false
        ]
      ],
      "write": "Pinch_Strip"
    }
  ],
  "steps": [
    {
      "id": "1",
      "checks": [
        {
          "op": "eq",
          "signal": "Liftgate_Position",
          "window": [
            0,
            1
          ],
          "expected": 0
        },
        {
          "op": "eq",
          "signal": "Liftgate_Motion",
          "window": [
            0,
            1
          ],
          "expected": "STOP"
        },
        {
          "op": "eq",
          "signal": "Liftgate_Fault",
          "window": [
            0,
            1
          ],
          "expected": "0x0000"
        }
      ],
      "description": "Verify liftgate is fully closed with vehicle speed at 0 km/h"
    },
    {
      "id": "2",
      "checks": [
        {
          "op": "eq",
          "signal": "Latch_Cmd",
          "window": [
            0,
            0.5
          ],
          "expected": "RELEASE",
          "tolerance": "T100ms"
        }
      ],
      "writes": [
        {
          "at": [
            [
              0,
              true
            ]
          ],
          "signal": "Liftgate_Switch_In"
        }
      ],
      "description": "Activate interior switch and verify module commands latch to unlock"
    },
    {
      "id": "3",
      "checks": [
        {
          "op": "eq",
          "signal": "Spindle_Dir",
          "window": [
            0,
            0.5
          ],
          "expected": "OPEN",
          "tolerance": "T100ms"
        },
        {
          "op": "eq",
          "signal": "Liftgate_Motion",
          "window": [
            0,
            0.5
          ],
          "expected": "OPENING",
          "tolerance": "T100ms"
        }
      ],
      "writes": [
        {
          "at": [
            [
              0,
              "RELEASED"
            ]
          ],
          "signal": "Latch_State"
        }
      ],
      "description": "Update latch state to released and verify spindle motors commanded to open liftgate"
    },
    {
      "id": "4",
      "checks": [
        {
          "op": "gt",
          "signal": "Liftgate_Position",
          "window": [
            0,
            2
          ],
          "expected": 10
        },
        {
          "op": "always_eq",
          "signal": "Liftgate_Motion",
          "window": [
            0,
            2
          ],
          "expected": "OPENING"
        }
      ],
      "description": "Verify liftgate opens and position increases from 0%"
    }
  ],
  "product": "plms",
  "teardown": [
    {
      "at": [
        [
          0,
          false
        ]
      ],
      "write": "Liftgate_Switch_In"
    }
  ],
  "schema_version": "1.0",
  "test_requirement_id": "PLM-TR-200-26"
}