{
  "id": "PLM-TP-200-48",
  "setup": [
    {
      "at": [
        [
          0,
          10
        ]
      ],
      "write": "Vehicle_Speed"
    },
    {
      "at": [
        [
          0,
          false
        ]
      ],
      "write": "Liftgate_Switch_In"
    },
    {
      "at": [
        [
          0,
          false
        ]
      ],
      "write": "Liftgate_Switch_Ext"
    },
    {
      "at": [
        [
          0,
          false
        ]
      ],
      "write": "Kick_Detected"
    },
    {
      "at": [
        [
          0,
          "PRIMARY"
        ]
      ],
      "write": "Latch_State"
    }
  ],
  "steps": [
    {
      "id": "1",
      "checks": [
        {
          "op": "always_eq",
          "signal": "Liftgate_Position",
          "window": [
            0,
            1
          ],
          "expected": 0
        },
        {
          "op": "always_eq",
          "signal": "Liftgate_Motion",
          "window": [
            0,
            1
          ],
          "expected": "STOP"
        }
      ],
      "description": "Verify vehicle speed is above 5 km/h"
    },
    {
      "id": "2",
      "checks": [
        {
          "op": "always_eq",
          "signal": "Liftgate_Motion",
          "window": [
            0,
            0.5
          ],
          "expected": "STOP"
        },
        {
          "op": "always_eq",
          "signal": "Liftgate_Position",
          "window": [
            0,
            0.5
          ],
          "expected": 0
        }
      ],
      "writes": [
        {
          "at": [
            [
              0,
              true
            ],
            [
              0.2,
              false
            ]
          ],
          "signal": "Liftgate_Switch_In"
        }
      ],
      "description": "Send interior switch request while vehicle speed is above 5 km/h"
    },
    {
      "id": "3",
      "checks": [
        {
          "op": "always_eq",
          "signal": "Liftgate_Motion",
          "window": [
            0,
            3.5
          ],
          "expected": "STOP"
        },
        {
          "op": "always_eq",
          "signal": "Liftgate_Position",
          "window": [
            0,
            3.5
          ],
          "expected": 0
        }
      ],
      "description": "Maintain vehicle speed above 5 km/h for more than 3 seconds after request"
    },
    {
      "id": "4",
      "checks": [
        {
          "op": "always_eq",
          "signal": "Liftgate_Motion",
          "window": [
            0,
            2
          ],
          "expected": "STOP"
        },
        {
          "op": "always_eq",
          "signal": "Liftgate_Position",
          "window": [
            0,
            2
          ],
          "expected": 0
        }
      ],
      "writes": [
        {
          "at": [
            [
              0,
              2
            ]
          ],
          "signal": "Vehicle_Speed"
        }
      ],
      "description": "Reduce vehicle speed below 5 km/h after timeout period"
    },
    {
      "id": "5",
      "checks": [
        {
          "op": "always_eq",
          "signal": "Liftgate_Motion",
          "window": [
            0,
            2
          ],
          "expected": "STOP"
        },
        {
          "op": "always_eq",
          "signal": "Liftgate_Position",
          "window": [
            0,
            2
          ],
          "expected": 0
        }
      ],
      "description": "Verify request was discarded and liftgate does not operate"
    }
  ],
  "product": "plms",
  "schema_version": "1.0",
  "test_requirement_id": "PLM-TR-200-48"
}