            0,
            1
          ],
          "expected": "STOP"
        },
        {
          "op": "always_eq",
          "signal": "Liftgate_Position",
          "window": [
            0,
            1
          ],
          "expected": 0
        }
      ],
      "writes": [
        {
          "at": [
            [
              0,
              5
            ]
          ],
          "signal": "Vehicle_Speed"
        },
        {
          "at": [
            [
              0.1,
              true
            ]
          ],
          "signal": "Liftgate_Switch_In"
        }
      ],
      "description": "Set vehicle speed to exactly 5.0 km/h and send interior switch request"
    },
    {
      "id": "2",
      "checks": [
        {
          "op": "always_eq",
          "signal": "Liftgate_Motion",
          "window": [
            0,
            1
          ],
          "expected": "STOP"
        },
        {
          "op": "always_eq",
          "signal": "Liftgate_Position",
          "window": [
            0,
            1
          ],
          "expected": 0
        }
      ],
      "writes": [
        {
          "at": [
            [
              0,
              false
            ]
          ],
          "signal": "Liftgate_Switch_In"
        },
        {
          "at": [
            [
              0.1,
              true
            ]
          ],
          "signal": "Liftgate_Switch_Ext"
        }
      ],
      "description": "Release interior switch and send exterior handle request at 5.0 km/h"
    },
    {
      "id": "3",
      "checks": [
        {
          "op": "always_eq",
          "signal": "Liftgate_Motion",
          "window": [
            0,
            1
          ],
          "expected": "STOP"
        },
        {
          "op": "always_eq",
          "signal": "Liftgate_Position",
          "window": [
            0,
            1
          ],
          "expected": 0
        }
      ],
      "writes": [
        {
          "at": [
            [
              0,
              false
            ]
          ],
          "signal": "Liftgate_Switch_Ext"
        },
        {
          "at": [
            [
              0.1,
              true
            ]
          ],
          "signal": "Kick_Detected"
        }
      ],
